// OpenCV SGBM3Way's winner-projected pseudo right map and consistency rule.
// See OPENCV-LICENSE. Row scatter mutates only workgroup-local storage.
layout(local_size_x = 128) in;
// Image size and penalties are specialization constants; the disparity
// range and lane layout stay compile-time macros.
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
layout(constant_id = 2) const int P1 = 8;
layout(constant_id = 3) const int P2 = 64;
layout(constant_id = 4) const float UNIQUENESS = 1.0526315789473684;
layout(set = 0, binding = 0) readonly buffer Left { float left_disparity[]; };
layout(set = 0, binding = 1) readonly buffer Winners { uint winners[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float consistent[]; };
#define MAX_WIDTH 4096
shared uint right_winners[MAX_WIDTH];
uint projected(int rx, int y) {
  return rx >= 0 && rx < WIDTH ? right_winners[rx] : 0xffffffffu;
}
bool disagrees(uint match, int rx, int d) {
  return rx >= 0 && rx < WIDTH && match != 0xffffffffu && abs(65535 - int(match & 65535u) - d) > 1;
}
void check_pixel(int pixel) {
  int x = pixel % WIDTH, y = pixel / WIDTH;
  float value = left_disparity[pixel];
  int lo = int(floor(value)), hi = int(ceil(value));
  uint lower = projected(x-lo,y);
  uint upper = lo == hi ? lower : projected(x-hi,y);
  bool rejected = disagrees(lower,x-lo,lo) && disagrees(upper,x-hi,hi);
  consistent[pixel] = value >= 0.0 && !rejected ? value : -1.0;
}
void main() {
  int y = int(gl_WorkGroupID.x);
  for (int x = int(gl_LocalInvocationID.x); x < WIDTH; x += 128) right_winners[x] = 0xffffffffu;
  barrier();
  for (int x = int(gl_LocalInvocationID.x); x < WIDTH; x += 128) {
    uint winner = winners[y * WIDTH + x];
    int d = int(winner & 65535u);
    int rx = x - d;
    if (winner != 0xffffffffu && rx >= 0 && rx < WIDTH) {
      // Equal costs favor the larger disparity, matching OpenCV's scatter.
      uint key = (winner & 0xffff0000u) | uint(65535 - d);
      atomicMin(right_winners[rx],key);
    }
  }
  barrier();
  for (int x = int(gl_LocalInvocationID.x); x < WIDTH; x += 128) check_pixel(y * WIDTH + x);
}
