// libSGM's median selection network and left/right consistency stages.
layout(local_size_x = 128) in;
// Image size and penalties are specialization constants; the disparity
// range and lane layout stay compile-time macros.
layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int HEIGHT = 480;
layout(constant_id = 2) const int P1 = 8;
layout(constant_id = 3) const int P2 = 64;
layout(constant_id = 4) const float UNIQUENESS = 1.0526315789473684;
layout(set = 0, binding = 0) readonly buffer Left { float left_disparity[]; };
#if MEDIAN_ONLY
layout(set = 0, binding = 1) writeonly buffer Output { float disparity[]; };
#else
layout(set = 0, binding = 1) readonly buffer Right { float right_disparity[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float disparity[]; };
#endif
void swap_values(inout float a, inout float b) { float t = min(a,b); b = max(a,b); a = t; }
float median(int x, int y, bool right_view) {
  float v[9];
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      int i = clamp(y + dy, 0, HEIGHT - 1) * WIDTH + clamp(x + dx, 0, WIDTH - 1);
#if MEDIAN_ONLY
      v[(dy + 1) * 3 + dx + 1] = left_disparity[i];
#else
      float value = right_view ? right_disparity[i] : left_disparity[i];
      v[(dy + 1) * 3 + dx + 1] = value < 0.0 ? 65535.0 : value;
#endif
    }
  }
  swap_values(v[0],v[1]); swap_values(v[3],v[4]); swap_values(v[6],v[7]);
  swap_values(v[1],v[2]); swap_values(v[4],v[5]); swap_values(v[7],v[8]);
  swap_values(v[0],v[1]); swap_values(v[3],v[4]); swap_values(v[6],v[7]);
  v[3] = max(v[0],v[3]); v[6] = max(v[3],v[6]);
  swap_values(v[1],v[4]); v[4] = min(v[4],v[7]); v[4] = max(v[1],v[4]);
  v[5] = min(v[5],v[8]); v[2] = min(v[2],v[5]);
  swap_values(v[2],v[4]); v[4] = min(v[4],v[6]); v[4] = max(v[2],v[4]);
  return v[4];
}
void main() {
  uint pixel = gl_GlobalInvocationID.x;
  if (pixel >= WIDTH * HEIGHT) return;
  int x = int(pixel) % WIDTH, y = int(pixel) / WIDTH;
  float d = median(x,y,false);
#if MEDIAN_ONLY
  disparity[pixel] = d;
#else
  float result = -1.0;
  // OpenCV's subpixel consistency rule accepts either adjacent integer match.
  int lo = int(floor(d)), hi = int(ceil(d));
  if (d >= 0.0 && d < DISPARITIES) {
    bool lower = x - lo >= 0 && x - lo < WIDTH && abs(median(x-lo,y,true) - float(lo)) <= 1.0;
    bool upper = x - hi >= 0 && x - hi < WIDTH && abs(median(x-hi,y,true) - float(hi)) <= 1.0;
    if (lower || upper) result = d;
  }
  disparity[pixel] = result;
#endif
}
